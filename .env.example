# ---- Core ----
BOT_TOKEN=123456:ABC-your-token-from-@BotFather
ADMIN_IDS=111111111,222222222
# ---- Database ----
# Leave blank for SQLite (fine locally, wiped on most free hosting).
# Set to a Postgres URL to keep your data across deploys, e.g. Supabase:
#   postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

DB_PATH=shop.db
SHOP_NAME=Rexova Shoppie
SUPPORT_URL=https://t.me/yourusername

# Fiat currency used for product prices (display + balance)
FIAT_CURRENCY=INR
CURRENCY_SYMBOL=₹
# Decimal places on every price. 2 for $4.50 style, 0 for whole rupees.
PRICE_DECIMALS=2
# Optional second currency toggle in the storefront (display only).
# A second currency buyers can switch the storefront to. Display only —
# charges are always taken in FIAT_CURRENCY. Leave blank to hide the switch.
# SECOND_RATE is how many of it equal one unit of your main currency.
SECOND_CURRENCY=INR
SECOND_SYMBOL=₹
SECOND_RATE=88

# ---- Payment providers (comma separated, order = display order) ----
# The four rails that verify automatically. Wallet balance is always offered
# at checkout regardless — it's where deposits land, not a rail you switch on.
# Others available if you want them: bybit, ltc, stars, upi, crypto (TRON),
# arbitrum, base, erc20 — but only these four confirm without you.
ENABLED_PROVIDERS=binance,bep20,polygon,ton

# ---- Telegram Stars (fully automatic, no extra setup) ----
# How many fiat units 1 Star is worth. Used to convert product price -> stars.
STARS_RATE=1.6

# ---- Crypto: USDT TRC-20 on TRON (automatic on-chain verification) ----
TRON_ADDRESS=TYourReceivingTronAddressHere
TRONGRID_API_KEY=
# 1 USDT = how many fiat units
USDT_RATE=90.0

# ---- Crypto on EVM chains (BEP20 / Polygon / Arbitrum / Base / ERC20) ----
# One receiving address and one Etherscan key cover every chain you enable.
EVM_ADDRESS=
ETHERSCAN_API_KEY=

# ---- Binance Pay (automatic verification) ----
# API key from the Binance account that RECEIVES the money.
# Create it with "Enable Reading" ONLY — no trading, no withdrawals — and
# restrict it to your server's IP. Leave blank to fall back to manual review.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- USDT on TON ----
TON_ADDRESS=
# Optional — only raises the TonAPI rate limit.
TONAPI_KEY=

# ---- Litecoin ----
LTC_ADDRESS=
# How many fiat units one LTC is worth. Required, or LTC prices can't be quoted.
LTC_RATE=0

# ---- UPI (India) ----
# Rupees per one unit of your shop currency. Only needed if UPI is enabled
# and your shop isn't priced in INR. Defaults to SECOND_RATE when that's INR.
# ---- Razorpay (UPI + cards, automatic) ----
# Dashboard -> Settings -> API Keys. Razorpay collects the payment and the bot
# delivers as soon as it confirms — no UTR to paste, no approval tap.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

INR_RATE=

UPI_VPA=yourname@okbank
UPI_PAYEE_NAME=Rexova Shoppie
# If a real PSP webhook is configured below, UPI verifies automatically.
# Otherwise the user submits a UTR and an admin approves it in the panel.

# ---- Mini Apps (storefront + admin panel) ----
WEBAPP_ENABLED=true
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Public HTTPS base URL. Telegram will not open a Mini App over http or an IP.
# For local dev: `cloudflared tunnel --url http://localhost:8080` and paste the URL here.
WEBAPP_URL=
# Lets you open /admin in a normal browser during development. Leave blank to disable.
ADMIN_PANEL_TOKEN=

# ---- Optional PSP webhook (Razorpay-style HMAC) for true UPI/card automation ----
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/psp/webhook
WEBHOOK_SECRET=change-me

# ---- Community links shown on /start ----
CHANNEL_URL=https://t.me/YourChannel
GROUP_URL=https://t.me/YourChat

# ---- Refer & Earn ----
# Paid to the referrer when their invitee completes their first purchase.
REFERRAL_BONUS=25
# Extra share of every purchase that invitee makes, in percent. 0 turns it off.
REFERRAL_PERCENT=5

# ---- Public sales feed ----
# Group/channel id to post anonymised sales to, e.g. -1001234567890.
# Add the bot to the group as an admin first. Also settable from the admin panel.
SALES_CHAT_ID=

# ---- Withdrawals & developer API ----
# Smallest deposit accepted on a chain rail, in your shop currency.
# Ask for an exact odd amount (10.0134) so simultaneous payments of the same
# size can't be confused. Off means buyers send the round figure they chose.
UNIQUE_AMOUNTS=false
MIN_DEPOSIT=1
MIN_WITHDRAWAL=10
WITHDRAW_METHODS=USDT TRC-20,USDT BEP20,UPI
DEVELOPER_API=true

# ---- Behaviour ----
# Timezone for dates shown to buyers, e.g. Asia/Kolkata, Asia/Dhaka, UTC.
TIMEZONE=UTC

ORDER_TTL_MINUTES=30
# Delete cancelled/expired/rejected orders after this many days. 0 = keep them.
# Delivered and paid orders are never deleted.
KEEP_ABANDONED_ORDERS_DAYS=7
POLL_INTERVAL_SECONDS=25
LOW_STOCK_ALERT=3
